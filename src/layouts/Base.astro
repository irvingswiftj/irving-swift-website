---
import '@fontsource-variable/tiktok-sans/wdth.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION, HOME_TITLE, AUTHOR, SOCIAL_LINKS } from '../consts';
import { schemaId } from '../lib/schema';

interface Props {
	title?: string;
	/** Shorter <title> for search results; the headline stays `title` everywhere else */
	seoTitle?: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	/** The header sits on top of a full-screen photograph (home page) */
	overlayHeader?: boolean;
	/** Credit lines for found pictures on this page, printed in the footer */
	credits?: string[];
	/** Extra schema.org nodes for this page, added to the site-wide WebSite and Person */
	schema?: Record<string, unknown>[];
}

const {
	title,
	seoTitle,
	description = SITE_DESCRIPTION,
	image,
	type = 'website',
	publishedTime,
	overlayHeader = false,
	credits = [],
	schema = [],
} = Astro.props;
// Search results cut titles at about 60 characters, so the site name only goes on when it fits
const pageTitle = seoTitle ?? title;
const suffixed = `${pageTitle} – ${SITE_TITLE}`;
const fullTitle = pageTitle ? (suffixed.length <= 60 ? suffixed : pageTitle) : HOME_TITLE;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/favicon.png', Astro.site);

const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': schemaId('website'),
			url: Astro.site!.href,
			name: SITE_TITLE,
			description: SITE_DESCRIPTION,
			inLanguage: 'en-GB',
			publisher: { '@id': schemaId('person') },
		},
		{
			'@type': 'Person',
			'@id': schemaId('person'),
			name: AUTHOR,
			url: new URL('/about-james-irving-swift/', Astro.site).href,
			jobTitle: 'CTO',
			sameAs: SOCIAL_LINKS.map((l) => l.href),
		},
		...schema,
	],
};
---

<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={AUTHOR} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/favicon-48.png" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href="/rss.xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#18232a" />

		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={title ?? SITE_TITLE} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		<meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
		<meta name="generator" content={Astro.generator} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<Header overlay={overlayHeader} />
		<main id="main">
			<slot />
		</main>
		<Footer credits={credits} />

		<script>
			import '../scripts/motion';
		</script>
	</body>
</html>
