---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getPublishedPosts, categorySlug } from '../lib/posts';

// Posts and pages share the WordPress-style root permalink: /<slug>/
export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const pages = await getCollection('pages');
	return [
		...posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'post' as const } })),
		...pages.map((entry) => ({ params: { slug: entry.id }, props: { entry, kind: 'page' as const } })),
	];
}

const { entry, kind } = Astro.props;
const { Content } = await render(entry);
const post = kind === 'post' ? (entry as Awaited<ReturnType<typeof getPublishedPosts>>[number]) : null;
const cover = post?.data.cover;
const ogImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---

<Base
	title={entry.data.title}
	description={entry.data.description}
	image={ogImage}
	type={post ? 'article' : 'website'}
	publishedTime={post?.data.pubDate}
	credits={post?.data.coverCredit ? [post.data.coverCredit] : []}
>
	{post && <div class="progress" data-progress aria-hidden="true" />}
	<article>
		<header class="head frame">
			<h1 data-split>{entry.data.title}</h1>
			<p class="standfirst" data-reveal style="--i: 1">{entry.data.description}</p>
			{
				post && (
					<p class="meta" data-reveal style="--i: 2">
						<FormattedDate date={post.data.pubDate} />
						{post.data.categories.length > 0 && (
							<>
								<span aria-hidden="true">—</span>
								<span>
									in{' '}
									{post.data.categories.map((c, i) => (
										<>
											{i > 0 && ', '}
											<a href={`/category/${categorySlug(c)}/`}>{c}</a>
										</>
									))}
								</span>
							</>
						)}
						{post.data.updatedDate && (
							<span class="updated">
								· Updated <FormattedDate date={post.data.updatedDate} />
							</span>
						)}
					</p>
				)
			}
		</header>

		{
			cover && (
				<figure class="cover frame" data-reveal style="--i: 3">
					<span class="cover-img" data-wipe>
					<Image src={cover} alt={post?.data.coverAlt ?? ''} widths={[640, 1024, 1600, 2400]} sizes="100vw" loading="eager" />
					</span>
					{post?.data.coverCredit && <figcaption>{post.data.coverCredit}</figcaption>}
				</figure>
			)
		}

		<div class="prose body frame">
			<Content />
		</div>

		{
			post && (
				<p class="prose back frame">
					<a class="button" href="/#notes">Back to all notes</a>
				</p>
			)
		}
	</article>
</Base>

<style>
	.head {
		max-width: var(--column);
		margin: clamp(2.5rem, 7vw, 5rem) auto 0;
		box-sizing: content-box;
		display: grid;
		gap: 1.25rem;
	}


	h1 {
		font-size: clamp(1.75rem, 1.1rem + 2vw, 2.75rem);
		line-height: 1.08;
	}

	.standfirst {
		max-width: 40rem;
		font-size: max(1.125rem, var(--step-body));
		font-weight: 500;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3em;
		color: var(--muted);
		font-size: var(--step-small);
	}

	.meta a {
		color: var(--ink);
	}

	.cover {
		margin: clamp(2.5rem, 5vw, 4rem) 0 0;
	}

	/* Reading progress along the top edge (--progress is written by scripts/motion.ts) */
	.progress {
		position: fixed;
		inset: 0 0 auto;
		height: 4px;
		z-index: 30;
		background: var(--accent);
		transform-origin: left;
		transform: scaleX(var(--progress, 0));
	}

	.cover-img {
		display: block;
		overflow: hidden;
	}

	.cover img {
		width: 100%;
		aspect-ratio: 21 / 9;
		object-fit: cover;
	}

	.cover figcaption {
		margin-top: 0.6rem;
		font-size: var(--step-small);
		color: var(--muted);
	}

	@media (max-width: 40rem) {
		/* Reading progress along the top edge (--progress is written by scripts/motion.ts) */
	.progress {
		position: fixed;
		inset: 0 0 auto;
		height: 4px;
		z-index: 30;
		background: var(--accent);
		transform-origin: left;
		transform: scaleX(var(--progress, 0));
	}

	.cover-img {
		display: block;
		overflow: hidden;
	}

	.cover img {
			aspect-ratio: 4 / 3;
		}
	}

	.body {
		margin-top: clamp(2.5rem, 5vw, 4rem);
		box-sizing: content-box;
	}

	.back {
		margin-top: 4rem;
		box-sizing: content-box;
	}
</style>
